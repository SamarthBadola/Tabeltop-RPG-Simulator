# Local secrets and environment files. Commit only documented templates such as .env.example.
.env
.env.*
!.env.example
!**/.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore

# Java / Maven / Gradle
**/target/
.gradle/
build/

# CMake / native build outputs
CMakeFiles/
CMakeCache.txt
cmake-build-*/
compile_commands.json
*.o
*.obj
*.a
*.lib
*.so
*.dll
*.dylib
*.exe

# IDEs and OS-generated files
.idea/
*.iml
.project
.classpath
.settings/
.DS_Store
Thumbs.db

# Local editor settings; shared recommendations may be committed explicitly later.
.vscode/*
!.vscode/extensions.json

# Logs and temporary output
*.log
*.tmp
*.swp
*.swo
